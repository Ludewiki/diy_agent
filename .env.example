# Copy to .env for local development. Never put real values in this file.
DEEPSEEK_API_KEY=
ORS_API_KEY=
WIKIMEDIA_USER_AGENT=TravelPlannerAgent/0.1 (contact: you@example.com)
LOG_LEVEL=INFO
PYTHONUTF8=1

# API/Worker runtime. SQLite is for local development; production should use PostgreSQL.
DATABASE_URL=sqlite:///./resources/agent_api.db
WORKER_POLL_SECONDS=1.0
SSE_POLL_SECONDS=0.5
SSE_HEARTBEAT_SECONDS=15.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
