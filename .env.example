# Copy to .env for local development. Never put real values in this file.
DEEPSEEK_API_KEY=
ORS_API_KEY=
WIKIMEDIA_USER_AGENT=TravelPlannerAgent/0.1 (contact: you@example.com)
LOG_LEVEL=INFO
PYTHONUTF8=1

# Local PostgreSQL container. Replace these values outside local development.
POSTGRES_DB=diy_agent
POSTGRES_USER=diy_agent
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5432
API_PORT=8000
DATABASE_URL=postgresql+psycopg://diy_agent:change-me-for-local-development@localhost:5432/diy_agent

# Worker lease/retry policy.
WORKER_POLL_SECONDS=1.0
WORKER_LEASE_SECONDS=120.0
WORKER_HEARTBEAT_SECONDS=30.0
WORKER_RETRY_DELAY_SECONDS=5.0
WORKER_MAX_ATTEMPTS=3
SSE_POLL_SECONDS=0.5
SSE_HEARTBEAT_SECONDS=15.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
