# Copy to .env for local development. Never put real values in this file.
DEEPSEEK_API_KEY=
ORS_API_KEY=
WIKIMEDIA_USER_AGENT=TravelPlannerAgent/0.1 (contact: you@example.com)
LOG_LEVEL=INFO
PYTHONUTF8=1

# Local PostgreSQL container. Replace these values outside local development.
POSTGRES_DB=diy_agent
POSTGRES_USER=diy_agent
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5432
API_PORT=8000
DATABASE_URL=postgresql+psycopg://diy_agent:change-me-for-local-development@localhost:5432/diy_agent

# Worker lease/retry policy.
WORKER_POLL_SECONDS=1.0
WORKER_LEASE_SECONDS=120.0
WORKER_HEARTBEAT_SECONDS=30.0
WORKER_RETRY_DELAY_SECONDS=5.0
WORKER_MAX_ATTEMPTS=3
SSE_POLL_SECONDS=0.5
SSE_HEARTBEAT_SECONDS=15.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Multi-turn context and per-Run safety limits.
CONTEXT_MAX_INPUT_TOKENS=12000
CONTEXT_SYSTEM_RESERVED_TOKENS=1400
CONTEXT_TOOL_RESERVED_TOKENS=3200
CONTEXT_OUTPUT_RESERVED_TOKENS=1800
CONTEXT_RECENT_MESSAGE_LIMIT=8
CONTEXT_SUMMARY_MAX_TOKENS=1200
AGENT_MAX_LLM_CALLS=6
AGENT_MAX_TOOL_CALLS=4

# OpenTelemetry. Compose sends OTLP to the local Collector automatically.
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_METRIC_EXPORT_INTERVAL_MS=5000
OTEL_TRACE_SAMPLE_RATIO=1.0
OTEL_SERVICE_NAME_PREFIX=diy-agent
OTEL_DEPLOYMENT_ENVIRONMENT=development
